    {
      "id": "8da95aa1",
      "cell_type": "code",
      "source": [
        "# 1. Подключение библиотеки\ninclude(\"Павленко/LR04/lab04_lib.jl\")\n\n# 2. Создание чистой сцены (эталона) и зашумленной сцены 2 (шум 0.05) при seed 101\nclean = clean4(2)\nnoisy = make_gray4(101; scene4(2)...)\n\n# 3. Расчет PSNR зашумленной сцены относительно эталона\npsnr_base = psnr_db(noisy, clean)\nprintln(\"PSNR зашумленной сцены (факт): \", psnr_base, \" дБ\")\nprintln(\"PSNR по теории (-20*lg(0.05)): \", -20 * log10(0.05), \" дБ\")\n\n# 4. Применение нерезкой маски (операция 4)\nsharp = unsharp4(noisy)\npsnr_after = psnr_db(sharp, clean)\nprintln(\"PSNR после нерезкой маски:    \", psnr_after, \" дБ\")\nprintln(\"Разница ΔPSNR:                \", psnr_after - psnr_base, \" дБ\")\n\n# 5. Сохранение трех PNG для отчета\nsave(\"clean_ref.png\", Gray.(clean))\nsave(\"noisy_input.png\", Gray.(noisy))\nsave(\"sharp_output.png\", Gray.(sharp))\nprintln(\"Файлы clean_ref.png, noisy_input.png и sharp_output.png успешно сохранены!\")\n\n# 6. Полный статистический расчет варианта 10 по серии seed 101..105\nvariant_summary4(10)"
      ],
      "execution_count": 0,
