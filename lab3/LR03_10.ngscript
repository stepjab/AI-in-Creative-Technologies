    {
      "id": "2a0e9f1e",
      "cell_type": "code",
      "source": [
        "# 1. Сравнение способов вычисления яркости\nscene = make_scene(101; scene_preset(2)...)\ng_man = luma_manual(scene)\ng_img = luma_images(scene)\nmax_diff = maximum(abs.(g_man .- g_img))\nprintln(\"1. Максимальная разность способов luma: \", max_diff)\n\n# 2. Воспроизводимость SHA-256\nsha_1 = array_sha(g_img)\nsha_2 = array_sha(luma_images(make_scene(101; scene_preset(2)...)))\nprintln(\"2. SHA-256 (seed 101): \", sha_1[1:16])\nprintln(\"   Повторный запуск:    \", sha_2[1:16])\nprintln(\"   Детерминизм подтвержден: \", sha_1 == sha_2)\n\n# 3. Сохранение изображений и графика гистограмм\nusing Plots\ng_factor = apply_factor(g_img, 4)\n\nsave(\"scene_base.png\", Gray.(g_img))\nsave(\"scene_factor.png\", Gray.(g_factor))\n\np = plot(\n    bar(1:32, hist_counts(g_img, 32), label=\"До растяжения (база)\", color=:steelblue, alpha=0.8),\n    bar(1:32, hist_counts(g_factor, 32), label=\"После растяжения (фактор)\", color=:crimson, alpha=0.8),\n    layout=(2, 1),\n    size=(700, 500),\n    title=[\"Гистограмма до воздействия (узкий диапазон)\" \"Гистограмма после линейного растяжения\"],\n    xlabel=\"Интервал яркости (1..32)\",\n    ylabel=\"Число пикселей\"\n)\nsavefig(p, \"histograms.png\")\nprintln(\"3. Файлы scene_base.png, scene_factor.png и histograms.png успешно созданы!\")"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "1. Максимальная разность способов luma: 6.019111098432006e-9\n2. SHA-256 (seed 101): 855526fd63358f26\n   Повторный запуск:    855526fd63358f26\n   Детерминизм подтвержден: true\n3. Файлы scene_base.png, scene_factor.png и histograms.png успешно созданы!\n"
        }
      ],
